@inject IJSRuntime JS

<div class="article-content @(!IsModalView && !isExpanded ? "truncated" : "")" @ref="contentElementRef">
    @ArticleContent
</div>

@if ((ShouldShowExpandButton || isExpanded) && !IsModalView)
{
    <div class="expand-post-section">
        <button type="button" class="expand-post-button" @onclick="ToggleExpanded">
            @(isExpanded ? SeeLessText : ClickToSeeFullPostText)
        </button>
    </div>
}

@code {
    [Parameter]
    public RenderFragment? ArticleContent { get; set; }

    [Parameter]
    public bool IsModalView { get; set; } = false;

    [Parameter]
    public bool IsTruncated { get; set; } = false;

    [Parameter]
    public bool ShouldShowExpandButton { get; set; } = false;

    [Parameter]
    public EventCallback OnShowPostDetail { get; set; }

    [Parameter]
    public EventCallback<ElementReference> OnContentElementRendered { get; set; }

    /// <summary>
    /// Localized text for the "See more" button that expands the post inline.
    /// </summary>
    [Parameter]
    public string ClickToSeeFullPostText { get; set; } = "See more";

    /// <summary>
    /// Localized text for the "See less" button that collapses an expanded post.
    /// </summary>
    [Parameter]
    public string SeeLessText { get; set; } = "See less";

    private ElementReference contentElementRef;
    private bool isExpanded;

    private void ToggleExpanded() => isExpanded = !isExpanded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && OnContentElementRendered.HasDelegate)
        {
            await OnContentElementRendered.InvokeAsync(contentElementRef);
        }
    }
}
