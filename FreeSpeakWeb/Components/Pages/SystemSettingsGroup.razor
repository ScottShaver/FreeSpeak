@page "/system-admin/settings/{GroupId}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "SystemAdministrator")]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using FreeSpeakWeb.Data
@using FreeSpeakWeb.Services.Settings

@inject ISystemSettingsService SettingsService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<SystemSettingsGroup> Logger
@inject IStringLocalizer<FreeSpeakWeb.Resources.Pages.SystemSettings> Localizer

<PageTitle>@Localizer["IndexTitle"]</PageTitle>

<div class="container-fluid mt-4">
    <nav aria-label="breadcrumb">
        <a href="/system-admin/settings" class="text-decoration-none"><i class="bi bi-arrow-left me-1"></i>@Localizer["BackToSettings"]</a>
    </nav>

    @if (_loading)
    {
        <p class="mt-3">@Localizer["Loading"]</p>
    }
    else if (_state == null)
    {
        <div class="alert alert-warning mt-3" role="alert">@Localizer["GroupNotFound"]</div>
    }
    else
    {
        <h1 class="my-3">@Localizer[_state.Group.NameKey]</h1>
        <p class="text-muted">@Localizer[_state.Group.DescriptionKey]</p>

        @if (_state.Group.RestartRequired)
        {
            <div class="alert alert-warning" role="status" data-testid="restart-banner">
                <i class="bi bi-exclamation-triangle me-2"></i>@Localizer["RestartBanner"]
            </div>
        }

        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert @(_messageIsError ? "alert-danger" : "alert-success")" role="status" data-testid="result-message">@_message</div>
        }

        @if (_errors.Count > 0)
        {
            <div class="alert alert-danger" role="alert" data-testid="validation-summary">@Localizer["ValidationSummary"]</div>
        }

        <form @onsubmit="SaveAsync" @onsubmit:preventDefault="true" data-testid="settings-form">
            @foreach (var field in _state.Fields)
            {
                var def = field.Definition;
                var id = "f_" + def.Key.Replace(':', '_').Replace('.', '_');
                @if (def.Section != null)
                {
                    <h5 class="mt-4">@Localizer[def.Section]</h5>
                }
                <div class="mb-3" data-testid="field-@def.Key">
                    <label for="@id" class="form-label">@(def.LabelIsLiteral ? def.LabelKey : Localizer[def.LabelKey])</label>
                    @switch (def.Type)
                    {
                        case SettingFieldType.Boolean:
                            <div class="form-check form-switch">
                                <input id="@id" class="form-check-input" type="checkbox" role="switch"
                                       checked="@(_values[def.Key] == "true")"
                                       @onchange="e => SetBool(def.Key, e)" />
                            </div>
                            break;
                        case SettingFieldType.Integer:
                            <input id="@id" class="form-control" type="text" inputmode="numeric"
                                   value="@_values[def.Key]" @onchange="e => _values[def.Key] = e.Value?.ToString()" />
                            break;
                        case SettingFieldType.LogLevel:
                            <select id="@id" class="form-select" @onchange="e => _values[def.Key] = e.Value?.ToString()">
                                @foreach (var level in SettingsCatalog.LogLevels)
                                {
                                    <option value="@level" selected="@(_values[def.Key] == level)">@level</option>
                                }
                            </select>
                            break;
                        case SettingFieldType.Secret:
                            <div class="mb-1">
                                <span class="badge @(field.IsSet ? "bg-success" : "bg-secondary")">@(field.IsSet ? Localizer["SecretSet"] : Localizer["SecretNotSet"])</span>
                            </div>
                            <input id="@id" class="form-control" type="password" autocomplete="new-password"
                                   placeholder="@Localizer["SecretReplacePlaceholder"]"
                                   value="@_values[def.Key]" @onchange="e => _values[def.Key] = e.Value?.ToString()" />
                            break;
                        default:
                            <input id="@id" class="form-control" type="text"
                                   value="@_values[def.Key]" @onchange="e => _values[def.Key] = e.Value?.ToString()" />
                            break;
                    }
                    @if (def.HelpKey != null)
                    {
                        <div class="form-text">@Localizer[def.HelpKey]</div>
                    }
                    @if (!field.IsOverridden && !field.Definition.IsSecret)
                    {
                        <div class="form-text" data-testid="default-@def.Key">@Localizer["UsingDefault"]</div>
                    }
                    @if (_errors.TryGetValue(def.Key, out var error))
                    {
                        <div class="text-danger small" data-testid="error-@def.Key">@Localizer[error.ResourceKey, error.Args]</div>
                    }
                </div>
            }

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary" disabled="@_busy">@Localizer["Save"]</button>
                <button type="button" class="btn btn-outline-secondary" disabled="@_busy" @onclick="ResetAsync">@Localizer["ResetToDefault"]</button>
                @if (_state.Group.Id == SettingsCatalog.VirusScanGroupId)
                {
                    <button type="button" class="btn btn-outline-info" disabled="@_busy" @onclick="TestConnectionAsync">@Localizer["TestConnection"]</button>
                }
            </div>
        </form>
    }
</div>

@code {
    [Parameter]
    public string GroupId { get; set; } = string.Empty;

    private SettingGroupState? _state;
    private readonly Dictionary<string, string?> _values = new();
    private Dictionary<string, SettingValidationError> _errors = new();
    private string? _userId;
    private string? _message;
    private bool _messageIsError;
    private bool _loading = true;
    private bool _busy;

    /// <inheritdoc/>
    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _message = null;
        _errors = new();
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _userId = UserManager.GetUserId(authState.User);
        await LoadAsync();
        _loading = false;
    }

    private void SetBool(string key, ChangeEventArgs e)
    {
        _values[key] = e.Value is true ? "true" : "false";
    }

    private async Task LoadAsync()
    {
        try
        {
            _state = await SettingsService.GetGroupAsync(GroupId, _userId ?? string.Empty);
        }
        catch (UnauthorizedAccessException)
        {
            _state = null;
        }

        _values.Clear();
        if (_state != null)
        {
            foreach (var field in _state.Fields)
            {
                _values[field.Definition.Key] = field.Definition.IsSecret ? string.Empty : field.Value;
            }
        }
    }

    private async Task SaveAsync()
    {
        if (_state == null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await SettingsService.SaveGroupAsync(_state.Group.Id, new Dictionary<string, string?>(_values), _userId ?? string.Empty);
            _errors = result.Errors.GroupBy(e => e.Key).ToDictionary(g => g.Key, g => g.First());
            if (result.Success)
            {
                await LoadAsync();
                _message = Localizer[result.RestartRequired && result.ChangedKeys.Count > 0 ? "SavedRestart" : "Saved"];
                _messageIsError = false;
            }
            else
            {
                _message = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save settings group {Group}", GroupId);
            _message = Localizer["SaveFailed"];
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResetAsync()
    {
        if (_state == null || _busy)
        {
            return;
        }

        _busy = true;
        try
        {
            await SettingsService.ResetGroupAsync(_state.Group.Id, _userId ?? string.Empty);
            _errors = new();
            await LoadAsync();
            _message = Localizer["ResetDone"];
            _messageIsError = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to reset settings group {Group}", GroupId);
            _message = Localizer["SaveFailed"];
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task TestConnectionAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        try
        {
            var result = await SettingsService.TestVirusScanConnectionAsync(
                _values.GetValueOrDefault("VirusScan:ClamAvHost"),
                _values.GetValueOrDefault("VirusScan:ClamAvPort"),
                _userId ?? string.Empty);
            _message = result.Success ? Localizer["TestSuccess"] : Localizer["TestFailed", Localizer[result.ErrorKey ?? "E_PingFailed", 1, 65535]];
            _messageIsError = !result.Success;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "ClamAV connection test failed");
            _message = Localizer["SaveFailed"];
            _messageIsError = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
