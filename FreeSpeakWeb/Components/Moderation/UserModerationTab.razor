@using FreeSpeakWeb.DTOs
@using FreeSpeakWeb.Services.Abstractions
@using Microsoft.Extensions.Localization

@inject IUserModerationService ModerationService
@inject IStringLocalizer<FreeSpeakWeb.Resources.Moderation.UserModeration> Localizer

<div data-testid="user-moderation-tab">
    <form class="row g-2 align-items-end mb-3" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <div class="col-12 col-md-8">
            <label class="form-label" for="user-search">@Localizer["SearchLabel"]</label>
            <input id="user-search" class="form-control" placeholder="@Localizer["SearchPlaceholder"]" @bind="term" @bind:event="oninput" data-testid="user-search" />
        </div>
        <div class="col-12 col-md-4">
            <button type="submit" class="btn btn-primary" disabled="@searching" data-testid="user-search-button">@Localizer["SearchButton"]</button>
        </div>
    </form>

    @if (results != null)
    {
        @if (results.Count == 0)
        {
            <p class="text-muted" data-testid="user-search-empty">@Localizer["NoResults"]</p>
        }
        else
        {
            <ul class="list-group mb-3" data-testid="user-search-results">
                @foreach (var user in results)
                {
                    <li class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                        <span>@user.DisplayName <span class="text-muted">@@@user.UserName</span></span>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => selectedUserId = user.UserId" data-testid="user-select">@Localizer["SelectUser"]</button>
                    </li>
                }
            </ul>
        }
    }

    @if (!string.IsNullOrEmpty(selectedUserId))
    {
        <UserModerationPanel @key="selectedUserId" ActorId="@UserId" TargetUserId="@selectedUserId" />
    }
</div>

@code {
    private string term = string.Empty;
    private bool searching;
    private IReadOnlyList<ModerationUserSummary>? results;
    private string? selectedUserId;

    /// <summary>
    /// Gets or sets the ID of the signed-in moderator or administrator.
    /// </summary>
    [Parameter, EditorRequired]
    public string UserId { get; set; } = string.Empty;

    /// <summary>
    /// Runs the user lookup.
    /// </summary>
    private async Task SearchAsync()
    {
        searching = true;
        try
        {
            results = await ModerationService.SearchUsersAsync(UserId, term);
            selectedUserId = null;
        }
        catch (Exception)
        {
            results = Array.Empty<ModerationUserSummary>();
        }
        finally
        {
            searching = false;
        }
    }
}
