@using FreeSpeakWeb.Data
@using FreeSpeakWeb.Services.Abstractions
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@using System.Globalization
@inject IStringLocalizer<FreeSpeakWeb.Resources.Admin.UserLockoutManagementModal> Localizer
@inject IUserLockoutService LockoutService
@inject ILogger<UserLockoutManagementModal> Logger

<div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-lock-fill me-2"></i>
                    @string.Format(Localizer["TitleFormat"].Value, User?.UserName)
                </h5>
                <button type="button" class="btn-close" @onclick="Close" disabled="@isProcessing"></button>
            </div>
            <div class="modal-body">
                @if (User != null)
                {
                    <div class="user-info-section mb-4">
                        <div class="d-flex align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(User.ProfilePictureUrl))
                            {
                                <img src="@User.ProfilePictureUrl" alt="@Localizer["ProfilePictureAlt"]" class="rounded-circle" style="width: 48px; height: 48px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                    <i class="bi bi-person-fill text-white fs-4"></i>
                                </div>
                            }
                            <div>
                                <div class="fw-bold">@User.FirstName @User.LastName</div>
                                <div class="text-muted small">@User.Email</div>
                            </div>
                        </div>
                    </div>

                    @if (isLoading)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">@Localizer["LoadingLockoutStatus"]</span>
                            </div>
                            <p class="text-muted mt-2">@Localizer["LoadingLockoutInfo"]</p>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
                        </div>
                    }
                    else
                    {
                        <!-- Current Lockout Status -->
                        <div class="card mb-4">
                            <div class="card-header">
                                <h6 class="mb-0">
                                    <i class="bi bi-info-circle me-2"></i>@Localizer["CurrentLockoutStatus"]
                                </h6>
                            </div>
                            <div class="card-body">
                                @if (currentLockoutEnd.HasValue && currentLockoutEnd.Value > DateTimeOffset.UtcNow)
                                {
                                    @if (isPermanentlyLocked)
                                    {
                                        <div class="alert alert-danger mb-0">
                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                            <strong>@Localizer["PermanentlyLockedOut"]</strong>
                                            <p class="mb-0 mt-2">@Localizer["PermanentlyLockedMessage"]</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning mb-0">
                                            <i class="bi bi-clock-fill me-2"></i>
                                            <strong>@Localizer["CurrentlyLockedOut"]</strong>
                                            <div class="mt-2">
                                                <div><strong>@Localizer["LockedUntil"]</strong> @currentLockoutEnd.Value.ToLocalTime().ToString("G", CultureInfo.CurrentCulture)</div>
                                                <div><strong>@Localizer["TimeRemaining"]</strong> @GetRemainingTimeDisplay()</div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-success mb-0">
                                        <i class="bi bi-check-circle me-2"></i>
                                        <strong>@Localizer["NotLockedOut"]</strong>
                                        <p class="mb-0 mt-2">@Localizer["NotLockedOutMessage"]</p>
                                    </div>
                                }

                                @if (accessFailedCount > 0)
                                {
                                    <div class="mt-3 pt-3 border-top">
                                        <div class="text-muted small">
                                            <i class="bi bi-exclamation-circle me-1"></i>
                                            @string.Format(Localizer["FailedLoginAttempts"].Value, accessFailedCount)
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Lockout Actions -->
                        <div class="card">
                            <div class="card-header">
                                <h6 class="mb-0">
                                    <i class="bi bi-gear me-2"></i>@Localizer["LockoutActions"]
                                </h6>
                            </div>
                            <div class="card-body">
                                <!-- Remove Lockout -->
                                @if ((currentLockoutEnd.HasValue && currentLockoutEnd.Value > DateTimeOffset.UtcNow) || accessFailedCount > 0)
                                {
                                    <div class="lockout-action-section mb-4">
                                        <h6 class="text-success">
                                            <i class="bi bi-unlock me-2"></i>@Localizer["RemoveLockout"]
                                        </h6>
                                        <p class="text-muted small">@Localizer["RemoveLockoutDescription"]</p>
                                        <button type="button" 
                                                class="btn btn-success"
                                                @onclick="RemoveLockout"
                                                disabled="@isProcessing">
                                            @if (isProcessing && currentAction == "remove")
                                            {
                                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                            }
                                            <i class="bi bi-unlock me-2"></i>@Localizer["RemoveLockoutResetButton"]
                                        </button>
                                    </div>
                                    <hr />
                                }

                                <!-- Permanent Lockout -->
                                <div class="lockout-action-section mb-4">
                                    <h6 class="text-danger">
                                        <i class="bi bi-ban me-2"></i>@Localizer["PermanentLockout"]
                                    </h6>
                                    <p class="text-muted small">
                                        @Localizer["PermanentLockoutDescription"]
                                    </p>
                                    <button type="button" 
                                            class="btn btn-danger"
                                            @onclick="SetPermanentLockout"
                                            disabled="@(isProcessing || isPermanentlyLocked)">
                                        @if (isProcessing && currentAction == "permanent")
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        }
                                        <i class="bi bi-ban me-2"></i>@(isPermanentlyLocked ? Localizer["AlreadyPermanentlyLocked"] : Localizer["SetPermanentLockout"])
                                    </button>
                                </div>

                                <hr />

                                <!-- Temporary Lockout by Duration -->
                                <div class="lockout-action-section mb-4">
                                    <h6 class="text-warning">
                                        <i class="bi bi-clock-history me-2"></i>@Localizer["TemporaryLockoutDuration"]
                                    </h6>
                                    <p class="text-muted small">@Localizer["TemporaryLockoutDurationDescription"]</p>

                                    <div class="row g-3">
                                        <div class="col-md-4">
                                            <label for="durationMinutes" class="form-label">@Localizer["Minutes"]</label>
                                            <input type="number" 
                                                   id="durationMinutes"
                                                   class="form-control" 
                                                   min="0"
                                                   max="59"
                                                   @bind="durationMinutes"
                                                   disabled="@isProcessing" />
                                        </div>
                                        <div class="col-md-4">
                                            <label for="durationHours" class="form-label">@Localizer["Hours"]</label>
                                            <input type="number" 
                                                   id="durationHours"
                                                   class="form-control" 
                                                   min="0"
                                                   max="23"
                                                   @bind="durationHours"
                                                   disabled="@isProcessing" />
                                        </div>
                                        <div class="col-md-4">
                                            <label for="durationDays" class="form-label">@Localizer["Days"]</label>
                                            <input type="number" 
                                                   id="durationDays"
                                                   class="form-control" 
                                                   min="0"
                                                   max="365"
                                                   @bind="durationDays"
                                                   disabled="@isProcessing" />
                                        </div>
                                    </div>

                                    @if (GetDurationInMinutes() > 0)
                                    {
                                        <div class="alert alert-info mt-3 mb-0">
                                            <small>
                                                <i class="bi bi-info-circle me-1"></i>
                                                @string.Format(Localizer["UserLockedUntil"].Value, GetCalculatedLockoutEnd().ToLocalTime().ToString("g", CultureInfo.CurrentCulture))
                                            </small>
                                        </div>
                                    }

                                    <button type="button" 
                                            class="btn btn-warning mt-3"
                                            @onclick="SetTemporaryLockoutByDuration"
                                            disabled="@(isProcessing || GetDurationInMinutes() == 0)">
                                        @if (isProcessing && currentAction == "duration")
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        }
                                        <i class="bi bi-clock me-2">                                        </i>@Localizer["SetTemporaryLockout"]                                    </button>
                                </div>

                                <hr />

                                <!-- Temporary Lockout by Specific Date/Time -->
                                <div class="lockout-action-section">
                                    <h6 class="text-warning">
                                        <i class="bi bi-calendar-event me-2"></i>@Localizer["TemporaryLockoutSpecificDate"]
                                    </h6>
                                    <p class="text-muted small">@Localizer["TemporaryLockoutSpecificDateDescription"]</p>

                                    <div class="mb-3">
                                        <label for="specificDateTime" class="form-label">@Localizer["LockoutUntil"]</label>
                                        <input type="datetime-local" 
                                               id="specificDateTime"
                                               class="form-control" 
                                               min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                                               @bind="specificLockoutDateTime"
                                               disabled="@isProcessing" />
                                        <small class="form-text text-muted">
                                            @Localizer["LockoutUntilHint"]
                                        </small>
                                    </div>

                                    <button type="button" 
                                            class="btn btn-warning"
                                            @onclick="SetTemporaryLockoutByDate"
                                            disabled="@(isProcessing || !specificLockoutDateTime.HasValue || specificLockoutDateTime.Value <= DateTime.Now)">
                                        @if (isProcessing && currentAction == "specific")
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        }
                                        <i class="bi bi-calendar-check me-2"></i>@Localizer["SetLockoutUntilDate"]
                                    </button>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success mt-3" role="alert">
                                <i class="bi bi-check-circle me-2"></i>@successMessage
                            </div>
                        }
                    }
                }
            </div>
            <div class="modal-footer">
                <button type="button" 
                        class="btn btn-secondary" 
                        @onclick="Close"
                        disabled="@isProcessing">
                    @Localizer["Close"]
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// The user whose lockout status is being managed.
    /// </summary>
    [Parameter]
    public ApplicationUser? User { get; set; }

    /// <summary>
    /// Event callback triggered when the modal is closed.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Event callback triggered when lockout status is successfully updated.
    /// </summary>
    [Parameter]
    public EventCallback OnLockoutUpdated { get; set; }

    private bool isLoading = true;
    private bool isProcessing = false;
    private string? errorMessage;
    private string? successMessage;
    private string currentAction = "";

    private DateTimeOffset? currentLockoutEnd;
    private bool isPermanentlyLocked = false;
    private int accessFailedCount = 0;

    private int durationMinutes = 0;
    private int durationHours = 0;
    private int durationDays = 0;
    private DateTime? specificLockoutDateTime;

    /// <summary>
    /// Initializes the modal by loading the user's current lockout status.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (User != null)
        {
            await LoadLockoutStatusAsync();
        }
    }

    /// <summary>
    /// Loads the current lockout status for the user.
    /// </summary>
    private async Task LoadLockoutStatusAsync()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            StateHasChanged();

            var status = await LockoutService.GetLockoutStatusAsync(User!.Id);
            currentLockoutEnd = status.LockoutEnd;
            accessFailedCount = status.AccessFailedCount;
            isPermanentlyLocked = status.IsPermanentlyLocked;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading lockout status for user {UserId}", User?.Id);
            errorMessage = Localizer["ErrorLoadStatus"];
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Removes the current lockout and resets failed login attempts.
    /// </summary>
    private async Task RemoveLockout()
    {
        if (User == null)
            return;

        try
        {
            isProcessing = true;
            currentAction = "remove";
            errorMessage = null;
            successMessage = null;
            StateHasChanged();

            var result = await LockoutService.RemoveLockoutAsync(User.Id);
            if (result)
            {
                successMessage = Localizer["LockoutRemoved"];
                Logger.LogInformation("Removed lockout for user {UserId} by system administrator", User.Id);
                await LoadLockoutStatusAsync();
                await OnLockoutUpdated.InvokeAsync();
            }
            else
            {
                errorMessage = Localizer["ErrorRemoveLockout"];
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error removing lockout for user {UserId}", User?.Id);
            errorMessage = string.Format(Localizer["ErrorRemoveLockoutDetail"].Value, ex.Message);
        }
        finally
        {
            isProcessing = false;
            currentAction = "";
            StateHasChanged();
        }
    }

    /// <summary>
    /// Sets a permanent lockout for the user.
    /// </summary>
    private async Task SetPermanentLockout()
    {
        if (User == null)
            return;

        try
        {
            isProcessing = true;
            currentAction = "permanent";
            errorMessage = null;
            successMessage = null;
            StateHasChanged();

            var result = await LockoutService.SetPermanentLockoutAsync(User.Id);
            if (result)
            {
                successMessage = Localizer["PermanentLockoutSet"];
                Logger.LogWarning("Set permanent lockout for user {UserId} by system administrator", User.Id);
                await LoadLockoutStatusAsync();
                await OnLockoutUpdated.InvokeAsync();
            }
            else
            {
                errorMessage = Localizer["ErrorSetPermanent"];
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error setting permanent lockout for user {UserId}", User?.Id);
            errorMessage = string.Format(Localizer["ErrorSetPermanentDetail"].Value, ex.Message);
        }
        finally
        {
            isProcessing = false;
            currentAction = "";
            StateHasChanged();
        }
    }

    /// <summary>
    /// Sets a temporary lockout based on duration from now.
    /// </summary>
    private async Task SetTemporaryLockoutByDuration()
    {
        if (User == null || GetDurationInMinutes() == 0)
            return;

        try
        {
            isProcessing = true;
            currentAction = "duration";
            errorMessage = null;
            successMessage = null;
            StateHasChanged();

            var duration = TimeSpan.FromMinutes(GetDurationInMinutes());
            var result = await LockoutService.SetTemporaryLockoutAsync(User.Id, duration);

            if (result)
            {
                successMessage = string.Format(Localizer["LockedOutForDuration"].Value, GetDurationDisplay());
                Logger.LogWarning("Set temporary lockout for user {UserId} (duration: {Duration}) by system administrator", 
                    User.Id, GetDurationDisplay());
                await LoadLockoutStatusAsync();
                await OnLockoutUpdated.InvokeAsync();

                // Reset duration inputs
                durationMinutes = 0;
                durationHours = 0;
                durationDays = 0;
            }
            else
            {
                errorMessage = Localizer["ErrorSetTemporary"];
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error setting temporary lockout for user {UserId}", User?.Id);
            errorMessage = string.Format(Localizer["ErrorSetTemporaryDetail"].Value, ex.Message);
        }
        finally
        {
            isProcessing = false;
            currentAction = "";
            StateHasChanged();
        }
    }

    /// <summary>
    /// Sets a temporary lockout until a specific date/time.
    /// </summary>
    private async Task SetTemporaryLockoutByDate()
    {
        if (User == null || !specificLockoutDateTime.HasValue || specificLockoutDateTime.Value <= DateTime.Now)
            return;

        try
        {
            isProcessing = true;
            currentAction = "specific";
            errorMessage = null;
            successMessage = null;
            StateHasChanged();

            // Convert the local datetime to UTC for PostgreSQL compatibility
            // PostgreSQL timestamp with time zone only accepts UTC offset (0)
            var localDateTime = specificLockoutDateTime.Value;
            var utcDateTime = DateTime.SpecifyKind(localDateTime, DateTimeKind.Local).ToUniversalTime();
            var lockoutEnd = new DateTimeOffset(utcDateTime, TimeSpan.Zero);

            var result = await LockoutService.SetLockoutEndAsync(User.Id, lockoutEnd);

            if (result)
            {
                successMessage = string.Format(Localizer["LockedOutUntilDate"].Value, specificLockoutDateTime.Value.ToString("g", CultureInfo.CurrentCulture));
                Logger.LogWarning("Set temporary lockout for user {UserId} (until: {LockoutEnd}) by system administrator", 
                    User.Id, lockoutEnd);
                await LoadLockoutStatusAsync();
                await OnLockoutUpdated.InvokeAsync();

                // Reset date input
                specificLockoutDateTime = null;
            }
            else
            {
                errorMessage = Localizer["ErrorSetTemporary"];
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error setting temporary lockout by date for user {UserId}", User?.Id);
            errorMessage = string.Format(Localizer["ErrorSetTemporaryDetail"].Value, ex.Message);
        }
        finally
        {
            isProcessing = false;
            currentAction = "";
            StateHasChanged();
        }
    }

    /// <summary>
    /// Closes the modal and invokes the OnClose callback.
    /// </summary>
    private async Task Close()
    {
        if (!isProcessing)
        {
            await OnClose.InvokeAsync();
        }
    }

    /// <summary>
    /// Calculates the total duration in minutes.
    /// </summary>
    private int GetDurationInMinutes()
    {
        return durationMinutes + (durationHours * 60) + (durationDays * 24 * 60);
    }

    /// <summary>
    /// Gets a friendly display string for the duration.
    /// </summary>
    private string GetDurationDisplay()
    {
        var parts = new List<string>();
        if (durationDays > 0) parts.Add(string.Format(Localizer["DurationDays"].Value, durationDays));
        if (durationHours > 0) parts.Add(string.Format(Localizer["DurationHours"].Value, durationHours));
        if (durationMinutes > 0) parts.Add(string.Format(Localizer["DurationMinutes"].Value, durationMinutes));
        return string.Join(Localizer["DurationSeparator"].Value, parts);
    }

    /// <summary>
    /// Calculates the lockout end time based on current duration inputs.
    /// </summary>
    private DateTimeOffset GetCalculatedLockoutEnd()
    {
        return DateTimeOffset.Now.AddMinutes(GetDurationInMinutes());
    }

    /// <summary>
    /// Gets a friendly display of the remaining lockout time.
    /// </summary>
    private string GetRemainingTimeDisplay()
    {
        if (!currentLockoutEnd.HasValue || isPermanentlyLocked)
            return Localizer["NotAvailable"];

        var remaining = currentLockoutEnd.Value - DateTimeOffset.UtcNow;
        if (remaining.TotalSeconds <= 0)
            return Localizer["Expired"];

        var parts = new List<string>();
        if (remaining.Days > 0) parts.Add(string.Format(Localizer["DurationDays"].Value, remaining.Days));
        if (remaining.Hours > 0) parts.Add(string.Format(Localizer["DurationHours"].Value, remaining.Hours));
        if (remaining.Minutes > 0) parts.Add(string.Format(Localizer["DurationMinutes"].Value, remaining.Minutes));
        if (parts.Count == 0 && remaining.Seconds > 0) parts.Add(string.Format(Localizer["DurationSeconds"].Value, remaining.Seconds));

        return string.Join(Localizer["DurationSeparator"].Value, parts);
    }
}
