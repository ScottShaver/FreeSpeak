@page "/Account/Lockout"

@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@using FreeSpeakWeb.Data

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IOptions<SiteSettings> SiteSettings
@inject ILogger<Lockout> Logger
@inject FreeSpeakWeb.Services.Abstractions.IUserModerationService ModerationService
@inject Microsoft.Extensions.Localization.IStringLocalizer<FreeSpeakWeb.Resources.Moderation.UserModeration> SuspensionLocalizer
@inject Microsoft.Extensions.Localization.IStringLocalizer<FreeSpeakWeb.Resources.Account.Pages.Lockout> Localizer

<PageTitle>@SiteSettings.Value.SiteName - @Localizer["PageTitle"]</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            @if (suspension != null)
            {
                <div class="card shadow" data-testid="suspension-card">
                    <div class="card-body">
                        <div class="text-center mb-4">
                            <i class="bi bi-slash-circle-fill text-danger" style="font-size: 4rem;"></i>
                        </div>
                        <h1 class="text-danger text-center mb-4" data-testid="suspension-title">@SuspensionLocalizer["LockoutSuspendedTitle"]</h1>
                        <div class="alert alert-danger" role="alert">
                            <p>@SuspensionLocalizer[suspension.IsPermanent ? "LockoutSuspendedPermanent" : "LockoutSuspendedTemporary"]</p>
                            @* The reason is intentionally not shown: this page is reachable without authentication. *@
                            @if (!suspension.IsPermanent)
                            {
                                <p class="mb-2" data-testid="suspension-until"><strong>@SuspensionLocalizer["LockoutUntilLabel"]:</strong> @DateTime.SpecifyKind(suspension.EndsAt!.Value, DateTimeKind.Utc).ToLocalTime().ToString("g", System.Globalization.CultureInfo.CurrentCulture) (@suspension.EndsAt.Value.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture) UTC)</p>
                            }
                            <p class="mb-0">@SuspensionLocalizer["LockoutContact"]</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
            <div class="card shadow">
                <div class="card-body">
                    <div class="text-center mb-4">
                        <i class="bi bi-lock-fill text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h1 class="text-danger text-center mb-4">@Localizer["Title"]</h1>

                    @if (isPermanentLockout)
                    {
                        <div class="alert alert-danger" role="alert">
                            <h5 class="alert-heading">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                @Localizer["PermanentTitle"]
                            </h5>
                            <p>@Localizer["PermanentDisabledMessage"]</p>
                            <hr />
                            <p class="mb-2">
                                <strong>@Localizer["ImportantLabel"]</strong> @Localizer["PermanentRecoveryNote"]
                            </p>
                            <p class="mb-0">
                                @Localizer["ContactAdminIfMistake"]
                            </p>
                        </div>
                    }
                    else if (lockoutEnd.HasValue && lockoutEnd.Value > DateTimeOffset.UtcNow)
                    {
                        <div class="alert alert-warning" role="alert">
                            <h5 class="alert-heading">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                @Localizer["TemporaryTitle"]
                            </h5>
                            <p>@Localizer["TemporaryMessage"]</p>

                            @if (remainingLockoutTime > TimeSpan.Zero)
                            {
                                <hr />
                                <div class="mb-2">
                                    <strong>@Localizer["LockedUntilLabel"]</strong> @FormatLocalTime(lockoutEnd.Value)
                                </div>
                                <div class="mb-2">
                                    <strong>@Localizer["TimeRemainingLabel"]</strong>&nbsp;
                                    @if (remainingLockoutTime.TotalHours >= 1)
                                    {
                                        <span>@FormatHours(remainingLockoutTime.Hours) @FormatMinutes(remainingLockoutTime.Minutes)</span>
                                    }
                                    else if (remainingLockoutTime.TotalMinutes >= 1)
                                    {
                                        <span>@FormatMinutes(remainingLockoutTime.Minutes) @FormatSeconds(remainingLockoutTime.Seconds)</span>
                                    }
                                    else
                                    {
                                        <span>@FormatSeconds(remainingLockoutTime.Seconds)</span>
                                    }
                                </div>
                            }

                            <hr />
                            <p class="mb-0">
                                <strong>@Localizer["WhatYouCanDoLabel"]</strong>
                            </p>
                            <ul class="mb-0">
                                <li>@Localizer["OptionWait"]</li>
                                <li>@LocalizedMarkup.Format(Localizer["OptionForgotPassword"].Value, LocalizedMarkup.Link("Account/ForgotPassword", Localizer["ForgotPasswordLink"].Value))</li>
                                <li>@Localizer["OptionContactSupport"]</li>
                            </ul>
                        </div>

                        @if (remainingLockoutTime > TimeSpan.Zero && remainingLockoutTime.TotalMinutes <= 5)
                        {
                            <div class="text-center mt-3">
                                <p class="text-muted">
                                    @Localizer["AutoUnlockNote"]
                                </p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info" role="alert">
                            <p class="mb-0">@LocalizedMarkup.Format(Localizer["LockoutExpired"].Value, LocalizedMarkup.Link("Account/Login", Localizer["TryLoginLink"].Value))</p>
                        </div>
                    }

                    <div class="text-center mt-4">
                        <a href="/" class="btn btn-primary">
                            <i class="bi bi-house me-2"></i>@Localizer["ReturnHome"]
                        </a>
                    </div>
                </div>
            </div>

            <div class="card mt-4">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-info-circle me-2"></i>
                        @if (isPermanentLockout)
                        {
                            <text>@Localizer["StatusCardTitle"]</text>
                        }
                        else if (lockoutEnd.HasValue && lockoutEnd.Value > DateTimeOffset.UtcNow)
                        {
                            <text>@Localizer["DetailsCardTitle"]</text>
                        }
                        else
                        {
                            <text>@Localizer["SecurityCardTitle"]</text>
                        }
                    </h5>

                    @if (isPermanentLockout)
                    {
                        <p class="card-text text-danger">
                            <strong>@Localizer["PermanentLockedByAdmin"]</strong>
                        </p>
                        <p class="card-text">
                            @Localizer["PermanentTypicalCause"]
                        </p>
                        <ul class="mb-2">
                            <li><strong>@Localizer["StatusLabel"]</strong> @Localizer["PermanentlyDisabled"]</li>
                            <li><strong>@Localizer["RecoveryOptionsLabel"]</strong> @Localizer["NoRecoveryOptions"]</li>
                            <li><strong>@Localizer["ContactLabel"]</strong> @Localizer["SiteAdminOnly"]</li>
                        </ul>
                        <p class="card-text mb-0">
                            @Localizer["OnlyAdminCanRemove"]
                        </p>
                    }
                    else if (lockoutEnd.HasValue && lockoutEnd.Value > DateTimeOffset.UtcNow)
                    {
                        <p class="card-text">
                            @Localizer["TemporarilyLockedMessage"]
                        </p>
                        <ul>
                            <li><strong>@Localizer["LockedUntilLabel"]</strong> @FormatLocalTime(lockoutEnd.Value)</li>
                            <li><strong>@Localizer["TimeRemainingLabel"]</strong>&nbsp;@FormatRemainingDetail(remainingLockoutTime)</li>
                            <li><strong>@Localizer["WhatToDoLabel"]</strong> @LocalizedMarkup.Format(Localizer["WhatToDoText"].Value, LocalizedMarkup.Link("Account/ForgotPassword", Localizer["PasswordResetLink"].Value))</li>
                        </ul>
                    }
                    else
                    {
                        <p class="card-text">
                            @Localizer["SecurityExplanation"]
                        </p>
                        <ul>
                            <li><strong>@Localizer["MaxAttemptsLabel"]</strong> @Localizer["MaxAttemptsValue", MaxFailedAccessAttempts]</li>
                            <li><strong>@Localizer["LockoutDurationLabel"]</strong> @Localizer["MinutesPlural", DefaultLockoutMinutes]</li>
                            <li><strong>@Localizer["ResetLabel"]</strong> @Localizer["ResetValue"]</li>
                        </ul>
                    }
                </div>
            </div>
            }
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// Username passed from login page when user gets locked out.
    /// </summary>
    [SupplyParameterFromQuery]
    public string? Username { get; set; }

    private bool isPermanentLockout;
    private FreeSpeakWeb.DTOs.ActiveSuspensionInfo? suspension;
    private DateTimeOffset? lockoutEnd;
    private TimeSpan remainingLockoutTime;

    // Mirrors the lockout policy configured in Program.cs (MaxFailedAccessAttempts / DefaultLockoutTimeSpan).
    private const int MaxFailedAccessAttempts = 5;
    private const int DefaultLockoutMinutes = 5;

    /// <summary>
    /// Formats a lockout end time in the server-local time zone using the current culture's long date/time pattern.
    /// </summary>
    /// <param name="value">The lockout end time.</param>
    /// <returns>The localized date and time text.</returns>
    private static string FormatLocalTime(DateTimeOffset value) =>
        value.ToLocalTime().ToString("G", System.Globalization.CultureInfo.CurrentCulture);

    /// <summary>
    /// Formats an hour count with the localized singular or plural resource.
    /// </summary>
    /// <param name="count">The number of hours.</param>
    /// <returns>The localized text, for example "1 hour" or "2 hours".</returns>
    private string FormatHours(int count) => Localizer[count == 1 ? "HoursSingular" : "HoursPlural", count].Value;

    /// <summary>
    /// Formats a minute count with the localized singular or plural resource.
    /// </summary>
    /// <param name="count">The number of minutes.</param>
    /// <returns>The localized text, for example "1 minute" or "2 minutes".</returns>
    private string FormatMinutes(int count) => Localizer[count == 1 ? "MinutesSingular" : "MinutesPlural", count].Value;

    /// <summary>
    /// Formats a second count with the localized singular or plural resource.
    /// </summary>
    /// <param name="count">The number of seconds.</param>
    /// <returns>The localized text, for example "1 second" or "2 seconds".</returns>
    private string FormatSeconds(int count) => Localizer[count == 1 ? "SecondsSingular" : "SecondsPlural", count].Value;

    /// <summary>
    /// Formats the remaining lockout time as space-separated hour, minute and second parts (seconds only when under an hour).
    /// </summary>
    /// <param name="remaining">The remaining lockout time.</param>
    /// <returns>The localized text, for example "4 minutes 59 seconds".</returns>
    private string FormatRemainingDetail(TimeSpan remaining)
    {
        var parts = new List<string>();
        if (remaining.Hours > 0)
        {
            parts.Add(FormatHours(remaining.Hours));
        }

        if (remaining.Minutes > 0)
        {
            parts.Add(FormatMinutes(remaining.Minutes));
        }

        if (remaining.Hours == 0)
        {
            parts.Add(FormatSeconds(remaining.Seconds));
        }

        return string.Join(' ', parts);
    }
    /// <summary>
    /// Initializes the lockout page and determines the lockout status and remaining time.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        ApplicationUser? user = null;

        // First try to get user from username parameter (for unauthenticated lockout scenarios)
        if (!string.IsNullOrWhiteSpace(Username))
        {
            try
            {
                user = await UserManager.FindByNameAsync(Username);
                if (user == null)
                {
                    Logger.LogWarning("User not found for lockout page: {Username}", Username);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error retrieving user by username for lockout page: {Username}", Username);
            }
        }

        // Fall back to authenticated user if no username parameter
        if (user == null)
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            user = await UserManager.GetUserAsync(authState.User);
        }

        if (user is not null)
        {
            suspension = await ModerationService.GetActiveSuspensionAsync(user.Id);
        }

        if (user is not null && user.LockoutEnd.HasValue)
        {
            lockoutEnd = user.LockoutEnd.Value;

            // Check if lockout is permanent (more than 100 years in the future)
            isPermanentLockout = lockoutEnd.Value > DateTimeOffset.UtcNow.AddYears(100);

            if (!isPermanentLockout)
            {
                // Calculate remaining time
                remainingLockoutTime = lockoutEnd.Value - DateTimeOffset.UtcNow;

                // Ensure we don't show negative time
                if (remainingLockoutTime < TimeSpan.Zero)
                {
                    remainingLockoutTime = TimeSpan.Zero;
                }
            }
        }
    }
}
