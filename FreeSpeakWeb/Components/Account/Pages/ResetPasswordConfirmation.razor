@page "/Account/ResetPasswordConfirmation"

@using Microsoft.Extensions.Options
@using Microsoft.Extensions.Localization
@inject IOptions<SiteSettings> SiteSettings
@inject IStringLocalizer<FreeSpeakWeb.Resources.Account.Pages.ResetPasswordConfirmation> Localizer

<PageTitle>@SiteSettings.Value.SiteName - @Localizer["PageTitle"]</PageTitle>

<h1>@Localizer["Title"]</h1>
<p role="alert">
    @LocalizedMarkup.Format(Localizer["Message"].Value, LocalizedMarkup.Link("Account/Login", Localizer["LoginLink"].Value))
</p>
